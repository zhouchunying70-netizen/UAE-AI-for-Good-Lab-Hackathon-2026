{"actor":"Policy Adviser Agent","payload":{"citations":[{"actual_sha256":"1d9f189c9f0c3ce5ea12f39b3d39d010838662cbe13dd57caaf7cb4f4f7d3b17","applicability":"Strategic design principle; it does not authorize a simulated Agent to reopen or operate a real service.","claim_id":"CLM-UAE-002","locator":"Dimensions section","official_url":"https://u.ae/en/about-the-uae/strategies-initiatives-and-awards/strategies-plans-and-visions/government-services-and-digital-transformation/uae-national-digital-government-strategy","paraphrase":"The UAE Digital Government Strategy includes resilience and proactive crisis capability among its eight dimensions.","source_id":"SRC-UAE-002","source_title":"The UAE Digital Government Strategy 2025","source_verification_status":"RAW_SOURCE_VERIFICATION_NOT_PERFORMED_IN_PUBLIC_BUNDLE"},{"actual_sha256":"1d9f189c9f0c3ce5ea12f39b3d39d010838662cbe13dd57caaf7cb4f4f7d3b17","applicability":"Supports traceable evidence handling and does not establish legal sufficiency of this prototype.","claim_id":"CLM-UAE-003","locator":"Data-driven dimension","official_url":"https://u.ae/en/about-the-uae/strategies-initiatives-and-awards/strategies-plans-and-visions/government-services-and-digital-transformation/uae-national-digital-government-strategy","paraphrase":"The strategy's data-driven dimension treats data as a strategic asset and calls for rules and ethical principles for trustworthy and safe reuse.","source_id":"SRC-UAE-002","source_title":"The UAE Digital Government Strategy 2025","source_verification_status":"RAW_SOURCE_VERIFICATION_NOT_PERFORMED_IN_PUBLIC_BUNDLE"},{"actual_sha256":"1f6c8dd3e3ad41eedd59af32817202d0e72c3967918a942695981984ead835d9","applicability":"Governs prototype behavior and escalation; it is not a delegation of UAE institutional authority.","claim_id":"CLM-UAE-004","locator":"Charter principles","official_url":"https://u.ae/en/about-the-uae/strategies-initiatives-and-awards/policies/Ai/The-UAE-Charter-for-the-Development-and-Use-of